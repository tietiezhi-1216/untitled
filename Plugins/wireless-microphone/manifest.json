{
  "schemaVersion": 2,
  "id": "com.untitled.wireless-microphone",
  "name": "无线麦",
  "version": "2.0.1",
  "summary": "查找和配对小米蓝牙遥控器 2 和 2 Pro，按住语音键即可在 Mac 收音。",
  "author": "tietiezhi-1216",
  "repository": "https://github.com/tietiezhi-1216/untitled",
  "minimumHostVersion": "0.13.55",
  "actions": ["shareWirelessMicrophone"],
  "templates": [],
  "permissions": [
    {
      "id": "system.bluetooth",
      "reason": "查找、配对和连接小米遥控器，读取按住语音键时的音频"
    }
  ],
  "icon": { "symbol": "mic.fill", "tint": "#267F87" },
  "ui": {
    "version": 1,
    "icon": "mic.fill",
    "slots": {
      "header.leading": [
        { "id": "icon", "kind": "component", "component": "host.icon" },
        { "id": "identity", "kind": "component", "component": "host.identity" }
      ],
      "header.trailing": [
        { "id": "enabled", "kind": "component", "component": "host.enabled" },
        { "id": "more", "kind": "component", "component": "host.more" },
        { "id": "info", "kind": "component", "component": "host.info" }
      ],
      "content": [
        { "id": "dashboard", "kind": "component", "component": "wirelessMicrophone.dashboard" }
      ],
      "menuBar": [
        { "id": "menu.open", "kind": "button", "command": "host.openPlugin" },
        { "id": "menu.toggle", "kind": "button", "command": "wirelessMicrophone.toggle" }
      ]
    }
  }
}
