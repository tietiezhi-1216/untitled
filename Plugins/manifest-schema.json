{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/tietiezhi-1216/untitled/main/Plugins/manifest-schema.json",
  "title": "Untitled plugin manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "summary",
    "author",
    "repository",
    "minimumHostVersion",
    "actions",
    "templates",
    "ui"
  ],
  "allOf": [
    {
      "if": { "properties": { "actions": { "contains": { "const": "sendNotification" } } } },
      "then": {
        "required": ["permissions"],
        "properties": {
          "permissions": { "contains": { "required": ["id"], "properties": { "id": { "const": "system.notifications" } } } }
        }
      }
    }
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "maxLength": 100,
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "summary": {
      "type": "string",
      "maxLength": 1000
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^https://github\\.com/[A-Za-z0-9][A-Za-z0-9._-]*/[A-Za-z0-9][A-Za-z0-9._-]*/?$"
    },
    "minimumHostVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/action" }
    },
    "shortcutInputs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["singleKey", "keyCombination", "mouseButton"] }
    },
    "styles": {
      "description": "Optional data-only styles, supported from Untitled 0.13.51. Swift validates version and geometry relationships.",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 8,
      "propertyNames": {
        "maxLength": 100,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.[A-Za-z0-9._-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 24,
        "propertyNames": { "maxLength": 36, "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
        "additionalProperties": {
          "oneOf": [
            { "type": "number" },
            {
              "type": "array", "minItems": 1, "maxItems": 8,
              "items": { "type": "string", "minLength": 1, "maxLength": 24 }
            }
          ]
        }
      },
      "properties": {
        "doubao.hud": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version"],
          "properties": {
            "version": { "const": 1 },
            "compactWidth": { "type": "number", "minimum": 80, "maximum": 116 },
            "compactHeight": { "type": "number", "minimum": 36, "maximum": 48 },
            "maximumWidth": { "type": "number", "minimum": 200, "maximum": 360 },
            "expandedHeight": { "type": "number", "minimum": 44, "maximum": 64 },
            "minimumCaptionWidth": { "type": "number", "minimum": 120, "maximum": 168 },
            "contentInset": { "type": "number", "minimum": 12, "maximum": 26 },
            "openingMilliseconds": { "type": "number", "minimum": 180, "maximum": 520 },
            "growthMilliseconds": { "type": "number", "minimum": 110, "maximum": 380 },
            "waveFadeEnd": { "type": "number", "minimum": 0.5, "maximum": 0.82 },
            "captionFadeStart": { "type": "number", "minimum": 0.18, "maximum": 0.36 },
            "driftSpeed": { "type": "number", "minimum": 0.25, "maximum": 1.6 },
            "driftAmount": { "type": "number", "minimum": 0.55, "maximum": 1.3 },
            "poolOpacity": { "type": "number", "minimum": 0.65, "maximum": 1.12 },
            "poolColors": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
            }
          }
        }
      }
    },
    "templates": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "action"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "action": { "$ref": "#/$defs/action" },
          "installByDefault": {
            "type": "boolean"
          },
          "defaultHotKey": {
            "type": "object",
            "additionalProperties": false,
            "oneOf": [
              { "required": ["keyCode", "modifiers", "key"], "not": { "required": ["mouseButton"] } },
              { "required": ["mouseButton", "modifiers"], "not": { "anyOf": [{ "required": ["keyCode"] }, { "required": ["key"] }] } }
            ],
            "properties": {
              "mouseButton": { "type": "integer", "minimum": 3, "maximum": 31 },
              "keyCode": {
                "description": "macOS 虚拟键码；54 搭配 modifiers: 0 是独立右 Command，62 搭配 modifiers: 0 是独立右 Control（最低宿主 0.13.32），属于 singleKey。",
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              },
              "modifiers": {
                "type": "integer",
                "minimum": 0
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 20
              }
            }
          }
        }
      }
    },
    "ui": {
      "$ref": "#/$defs/interface"
    },
    "permissions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "optional": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "icon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "symbol",
        "tint"
      ],
      "properties": {
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9.]+$"
        },
        "tint": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}$"
        },
        "png": {
          "type": "string",
          "maxLength": 87384,
          "contentEncoding": "base64",
          "contentMediaType": "image/png",
          "description": "Optional static square PNG, 32–256 pixels, at most 64 KiB decoded."
        }
      }
    },
    "storefront": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "categorySymbol",
        "headline",
        "caption"
      ],
      "description": "Store gallery metadata; requires minimumHostVersion 0.12.0 or newer.",
      "properties": {
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 24
        },
        "categorySymbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "^[a-zA-Z0-9.]+$"
        },
        "headline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "caption": {
          "type": "string",
          "maxLength": 120
        },
        "jpeg": {
          "type": "string",
          "maxLength": 131072,
          "contentEncoding": "base64",
          "contentMediaType": "image/jpeg",
          "description": "Static landscape JPEG; decoded size at most 96 KiB, width 400–1200, height 256–800, at most 960,000 pixels."
        }
      }
    }
  },
  "$defs": {
    "action": {
      "description": "Stable action ID. The running host must have a registered implementation.",
      "type": "string",
      "maxLength": 100,
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "kind": {
          "enum": [
            "component",
            "button",
            "menu",
            "panel",
            "tabs"
          ]
        },
        "component": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.[A-Za-z0-9._-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "command": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.[A-Za-z0-9._-]+$"
        },
        "panel": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "panels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          }
        },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 160,
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "style": {
          "enum": [
            "plain",
            "standard",
            "prominent"
          ]
        },
        "presentation": {
          "enum": [
            "sheet",
            "popover",
            "inline"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "component"
              }
            }
          },
          "then": {
            "required": [
              "component"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "command"
                  ]
                },
                {
                  "required": [
                    "panel"
                  ]
                },
                {
                  "required": [
                    "panels"
                  ]
                },
                {
                  "required": [
                    "items"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "button"
              }
            }
          },
          "then": {
            "required": [],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "component"
                  ]
                },
                {
                  "required": [
                    "panels"
                  ]
                },
                {
                  "required": [
                    "items"
                  ]
                }
              ]
            },
            "oneOf": [
              {
                "required": [
                  "command"
                ],
                "not": {
                  "required": [
                    "panel"
                  ]
                }
              },
              {
                "required": [
                  "panel"
                ],
                "not": {
                  "required": [
                    "command"
                  ]
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "menu"
              }
            }
          },
          "then": {
            "required": [
              "title",
              "items"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "component"
                  ]
                },
                {
                  "required": [
                    "command"
                  ]
                },
                {
                  "required": [
                    "panel"
                  ]
                },
                {
                  "required": [
                    "panels"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "panel"
              }
            }
          },
          "then": {
            "required": [
              "panel"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "component"
                  ]
                },
                {
                  "required": [
                    "command"
                  ]
                },
                {
                  "required": [
                    "panels"
                  ]
                },
                {
                  "required": [
                    "items"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "tabs"
              }
            }
          },
          "then": {
            "required": [
              "panels"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "component"
                  ]
                },
                {
                  "required": [
                    "command"
                  ]
                },
                {
                  "required": [
                    "panel"
                  ]
                },
                {
                  "required": [
                    "items"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "slots": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "header.leading",
          "header.trailing",
          "toolbar.leading",
          "toolbar.trailing",
          "content",
          "footer.leading",
          "footer.trailing",
          "menuBar"
        ]
      },
      "additionalProperties": {
        "type": "array",
        "maxItems": 160,
        "items": {
          "$ref": "#/$defs/item"
        }
      },
      "required": [
        "content"
      ],
      "properties": {
        "content": {
          "type": "array",
          "minItems": 1,
          "maxItems": 160,
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      }
    },
    "panelSlots": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "header.leading",
          "header.trailing",
          "toolbar.leading",
          "toolbar.trailing",
          "content",
          "footer.leading",
          "footer.trailing"
        ]
      },
      "additionalProperties": {
        "type": "array",
        "maxItems": 160,
        "items": {
          "$ref": "#/$defs/item"
        }
      },
      "required": [
        "content"
      ],
      "properties": {
        "content": {
          "type": "array",
          "minItems": 1,
          "maxItems": 160,
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      }
    },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "slots"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "slots": {
          "$ref": "#/$defs/slots"
        },
        "panels": {
          "type": "array",
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/panel"
          }
        }
      }
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "component": {
          "type": "string",
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.[A-Za-z0-9._-]+$"
        },
        "slots": {
          "$ref": "#/$defs/panelSlots"
        },
        "width": {
          "type": "number",
          "minimum": 320,
          "maximum": 1200
        },
        "height": {
          "type": "number",
          "minimum": 240,
          "maximum": 900
        }
      },
      "oneOf": [
        {
          "required": [
            "component"
          ],
          "not": {
            "required": [
              "slots"
            ]
          }
        },
        {
          "required": [
            "slots"
          ],
          "not": {
            "required": [
              "component"
            ]
          }
        }
      ]
    }
  }
}
